---
// src/components/GraphicSpecies.astro

// 1. On importe les données
import penguins from '../data/penguins.json';

// 2. On récupère l'espèce passée au composant
const { species } = Astro.props;

// 3. On filtre
const filteredPenguins = penguins.filter(p => p.species === species);
---

<div class="my-8">
  <h2>Graphique de l'espèce : {species}</h2>
  
  <!-- 4. ASTUCE : On stocke les données dans les attributs "data-species" et "data-penguins" -->
  <div 
    class="plot-container" 
    data-species={species} 
    data-penguins={JSON.stringify(filteredPenguins)}
  ></div>
</div>

<!-- 5. Script normal (Astro va automatiquement en faire un module) -->
<script>
  import * as Plot from '@observablehq/plot';

  const containers = document.querySelectorAll<HTMLElement>('.plot-container');

  containers.forEach((container) => {
    const species = container.dataset.species ?? 'inconnu';
    const penguinsData = JSON.parse(container.dataset.penguins ?? '[]') as Array<Record<string, number | string | null>>;

    console.log(`Données chargées pour ${species}:`, penguinsData);

    const chart = Plot.plot({
      marginLeft: 50,
      marks: [
        Plot.dot(penguinsData, {
          x: 'flipper_length_mm',
          y: 'body_mass_g',
          fill: 'orange'
        })
      ]
    });

    container.append(chart);
  });
</script>