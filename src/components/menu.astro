---
const { active } = Astro.props;
const currentPath = Astro.url.pathname;

const tabs = [
  { id: "home", label: "Accueil", href: "/" },
  { id: "graphique1", label: "Graphique 1", href: "/#penguins-scatter" },
  { id: "graphique2", label: "Graphique 2", href: "/graphique-2" },
  { id: "graphique3", label: "Graphique 3", href: "/graphique" },
  { id: "graphique4", label: "Graphique 4", href: "/graphique-4" },
  { id: "species", label: "Trie par Especes", href: "/species" },
  { id: "adelie", label: "Adelie", href: "/species/Adelie" },
  { id: "gentoo", label: "Gentoo", href: "/species/Gentoo" },
  { id: "chinstrap", label: "Chinstrap", href: "/species/Chinstrap" },
];
---

<nav class="pink-nav" aria-label="Navigation principale">
  <ul class="pink-nav__list" role="list">
    {
      tabs.map((tab) => {
        const isActive = tab.id === active || (!active && tab.href === currentPath);
        return (
          <li class:list={['pink-nav__item', isActive && 'is-active']}>
            <a href={tab.href} class="pink-nav__link">{tab.label}</a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .pink-nav {
    width: min(1100px, calc(100% - 1.5rem));
    margin: 0 auto 1rem;
    padding: 1rem 1.2rem;
    background: #f4dfe7;
    border: 2px solid #ef9bb6;
    border-radius: 28px;
  }

  .pink-nav__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.8rem 0.9rem;
    margin: 0;
    padding: 0;
  }

  .pink-nav__item {
    display: inline-flex;
    align-items: center;
  }

  .pink-nav__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.7rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: linear-gradient(180deg, #f9d6e5 0%, #f2bfd4 100%);
    border: 2px solid #ee9db7;
    color: #1d1d1d;
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.2;
    transition: none;
  }

  .pink-nav__item.is-active .pink-nav__link {
    background: linear-gradient(180deg, #f9dfe9 0%, #f4c3d5 100%);
    border-color: #df7096;
  }

  @media (max-width: 720px) {
    .pink-nav {
      padding: 0.8rem;
    }

    .pink-nav__list {
      gap: 0.6rem 0.7rem;
    }

    .pink-nav__link {
      font-size: 0.9rem;
      padding: 0.45rem 0.8rem;
    }
  }
</style>
