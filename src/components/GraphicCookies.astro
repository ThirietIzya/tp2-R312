---
import * as Plot from '@observablehq/plot';
import { JSDOM } from 'jsdom';
import cookies from '../data/cookies.json';

interface Props {
  type?: 'Chocolat' | 'Fruit' | 'Noix' | 'Avoine' | 'all' | string;
  title?: string;
}

const { type = 'all', title } = Astro.props;

// Filtrage de la base de données selon le type demandé
const filteredCookies = (type && type !== 'all')
  ? cookies.filter(({ type: t }) => t.toLowerCase() === type.toLowerCase())
  : cookies;

// Calculs statistiques sur la base filtrée
const count = filteredCookies.length;
const avgCalories = Math.round(
  filteredCookies.reduce((acc, c) => acc + c.calories, 0) / (count || 1)
);
const avgSugar = Math.round(
  (filteredCookies.reduce((acc, c) => acc + c.sugar_g, 0) / (count || 1)) * 10
) / 10;
const avgRating = (
  filteredCookies.reduce((acc, c) => acc + c.rating, 0) / (count || 1)
).toFixed(1);

const typeColors: Record<string, string> = {
  Chocolat: '#854d0e',
  Fruit: '#e11d48',
  Noix: '#d97706',
  Avoine: '#059669',
  all: '#d81b60'
};

const activeColor = typeColors[type] ?? '#d81b60';

// Configuration du graphique Observable Plot côté serveur
const plot = Plot.plot({
  document: new JSDOM("").window.document,
  title: title ?? (type === 'all' ? 'Toutes les recettes de Cookies' : `Cookies catégorie : ${type}`),
  subtitle: 'Apport calorique (kcal) vs Teneur en sucre (g)',
  caption: `Échantillon filtré de ${count} recettes observées.`,
  ariaLabel: `Nuage de points nutritionnel des cookies ${type}`,
  grid: true,
  inset: 12,
  width: 740,
  height: 380,
  marginLeft: 60,
  marginBottom: 45,
  color: {
    legend: type === 'all',
    domain: ['Chocolat', 'Fruit', 'Noix', 'Avoine'],
    range: ['#854d0e', '#e11d48', '#d97706', '#059669']
  },
  x: { label: 'Teneur en sucre (g) →', nice: true },
  y: { label: '↑ Calories (kcal)', nice: true },
  marks: [
    Plot.linearRegressionY(filteredCookies, {
      x: 'sugar_g',
      y: 'calories',
      stroke: activeColor,
      strokeWidth: 2,
      strokeOpacity: 0.5
    }),
    Plot.dot(filteredCookies, {
      x: 'sugar_g',
      y: 'calories',
      fill: type === 'all' ? 'type' : activeColor,
      stroke: '#ffffff',
      strokeWidth: 1.5,
      r: 7,
      fillOpacity: 0.85,
      title: (d) => `Recette : ${d.name}\nType : ${d.type}\nSucre : ${d.sugar_g}g\nCalories : ${d.calories} kcal\nNote : ⭐ ${d.rating}/5\nPrix : ${d.price_eur.toFixed(2)} €`
    })
  ]
});
---

<div class="rounded-3xl border-2 border-pink-200 bg-white/95 p-6 sm:p-8 shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-4 border-b border-pink-100">
    <div>
      <span class="inline-block px-3 py-1 bg-pink-100 text-pink-900 border border-pink-300 rounded-full text-xs font-black uppercase tracking-wider mb-2">
        {type === 'all' ? 'Base Complète' : `Filtre : ${type}`}
      </span>
      <h3 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
        {title ?? (type === 'all' ? 'Toutes les variétés de Cookies 🍪' : `Sélection ${type} 🍪`)}
      </h3>
    </div>

    <!-- Indicateurs clés calculés sur la base filtrée -->
    <div class="flex flex-wrap gap-2 text-xs">
      <div class="bg-pink-50/70 px-3 py-1.5 rounded-xl border border-pink-200 shadow-xs">
        <span class="text-slate-500 font-medium">Recettes :</span> <strong class="text-slate-900">{count}</strong>
      </div>
      <div class="bg-pink-50/70 px-3 py-1.5 rounded-xl border border-pink-200 shadow-xs">
        <span class="text-slate-500 font-medium">Calories moy. :</span> <strong class="text-slate-900">{avgCalories} kcal</strong>
      </div>
      <div class="bg-pink-50/70 px-3 py-1.5 rounded-xl border border-pink-200 shadow-xs">
        <span class="text-slate-500 font-medium">Sucre moy. :</span> <strong class="text-slate-900">{avgSugar} g</strong>
      </div>
      <div class="bg-pink-50/70 px-3 py-1.5 rounded-xl border border-pink-200 shadow-xs">
        <span class="text-slate-500 font-medium">Note moy. :</span> <strong class="text-slate-900">⭐ {avgRating}/5</strong>
      </div>
    </div>
  </div>

  <figure class="plot-figure-container flex justify-center items-center overflow-x-auto" set:html={plot.outerHTML} />
</div>

