---
import "../styles/global.css";
import Menu from "../components/menu.astro";
import Footer from "../components/footer.astro";

interface Props {
	title?: string;
	description?: string;
	activeTab?: string;
}

const {
	title = "Visualisation de données - TP2 Astro",
	description = "Application d'exploration de données avec Astro et Observable Plot",
	activeTab
} = Astro.props;
---
<!doctype html>
<html lang="fr" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body id="top" class="bg-gradient-to-br from-pink-50 via-rose-50/40 to-slate-50 min-h-screen text-slate-800 flex flex-col font-sans selection:bg-pink-200 selection:text-pink-900">
		<header class="pt-6 pb-2 px-4">
			<Menu active={activeTab} />
		</header>

		<main class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
			<slot />
		</main>

		<Footer />
	</body>
</html>

