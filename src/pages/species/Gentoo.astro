---
import Layout from "../../layouts/Layout.astro";
import GraphicSpecies from "../../components/GraphicSpecies.astro";
import SpeciesNav from "../../components/SpeciesNav.astro";
---

<Layout title="Espèce Gentoo - Manchots Palmer" activeTab="gentoo">
  <div class="space-y-6">
    <!-- En-tête de la page -->
    <div class="text-center space-y-2">
      <span class="inline-block px-3 py-1 bg-sky-100 text-sky-800 border border-sky-300 rounded-full text-xs font-bold uppercase tracking-wider">
        Sous-page Espèce
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        Les manchots <span class="text-sky-600">Gentoo</span>
      </h1>
      <p class="text-slate-600 max-w-2xl mx-auto text-sm sm:text-base">
        Les manchots Papous (<em>Pygoscelis papua</em>) sont reconnaissables à leur taille imposante et leur bonnet blanc distinctif sur le sommet de la tête.
      </p>
    </div>

    <!-- Navigation secondaire entre espèces -->
    <SpeciesNav current="Gentoo" />

    <!-- Graphique réutilisable -->
    <GraphicSpecies species="Gentoo" />
  </div>
</Layout>
