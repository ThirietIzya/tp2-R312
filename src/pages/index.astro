---
import PlotFigure from '../components/PlotFigure.astro';
import Menu from '../components/menu.astro';
import Footer from '../components/footer.astro';
import * as Plot from "@observablehq/plot";
import penguins from '../data/penguins.json';

// Graphique 1 : Nuage de points
const penguinsChartOptions = {
  title: "Longueur des nageoires vs Masse corporelle",
  subtitle: "Données de la station Palmer",
  caption: "Figure 1. Nuage de points des manchots par espèce.",
  ariaLabel: "Nuage de points représentant la masse corporelle en fonction de la taille des nageoires",
  grid: true,
  x: { label: "Nageoire (mm)" },
  y: { label: "Masse (g)" },
  color: { legend: true },
  marks: [
    Plot.dot(penguins, { x: "flipper_length_mm", y: "body_mass_g", stroke: "species" })
  ]
};

---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>TP Astro - Observable Plot</title>
  </head>
  <body id="top" style="max-width: 800px; margin: 2rem auto; font-family: sans-serif;">
    <Menu />
    <h1>Visualisation de données avec Observable Plot & Astro</h1>

    <section id="penguins-scatter">
      <h2>Graphique 1 : Manchots (Scatter Plot)</h2>
      <figure>
        <PlotFigure options={penguinsChartOptions} />
      </figure>
    </section>

    <nav class="new-graphs" aria-label="Accéder aux nouveaux graphiques">
      <a href="/graphique-2">Graphique 2</a>
      <a href="/graphique">Graphique 3</a>
      <a href="/graphique-4">Graphique 4</a>
    </nav>

    <Footer />
  </body>
</html>

<style>
  .new-graphs {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin: 2rem 0;
  }

  .new-graphs a {
    padding: 0.4rem 0.75rem;
    border: 2px solid #d94a8c;
    border-radius: 999px;
    background: linear-gradient(180deg, #ffb7d0 0%, #f091b8 100%);
    color: #3a001e;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
  }

  .new-graphs a:hover,
  .new-graphs a:focus-visible {
    background: linear-gradient(180deg, #f3a9c7 0%, #e76ea2 100%);
  }
</style>