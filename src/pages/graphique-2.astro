---
import Layout from '../layouts/Layout.astro';
import PlotFigure from '../components/PlotFigure.astro';
import GraphNavigation from '../components/GraphNavigation.astro';
import * as Plot from '@observablehq/plot';
import penguins from '../data/penguins.json';

const secondChartOptions = {
	title: "Nombre d'individus par espèce",
	subtitle: "Répartition globale de la population étudiée",
	caption: 'Figure 2. Effectif représenté par un diagramme en barres horizontales.',
	ariaLabel: 'Diagramme en barres montrant le nombre de manchots par espèce',
	width: 760,
	height: 320,
	marginLeft: 90,
	marginBottom: 40,
	x: { label: "Nombre d'individus →", grid: true },
	y: { label: "Espèce" },
	color: {
		domain: ["Adelie", "Chinstrap", "Gentoo"],
		range: ["#ea580c", "#9333ea", "#0284c7"]
	},
	marks: [
		Plot.barX(penguins, Plot.groupY({ x: 'count' }, { y: 'species', fill: 'species', inset: 4 })),
		Plot.text(penguins, Plot.groupY({ x: 'count', text: 'count' }, { y: 'species', dx: 14, fontWeight: 'bold' })),
		Plot.ruleX([0])
	]
};
---

<Layout title="Graphique 2 - Effectif par espèce" activeTab="graphique2">
	<div class="space-y-8">
		<!-- En-tête -->
		<div class="text-center space-y-3">
			<span class="inline-block px-3 py-1 bg-pink-100 text-pink-800 border border-pink-300 rounded-full text-xs font-bold uppercase tracking-wider">
				Graphique 2
			</span>
			<h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
				Effectif par <span class="text-pink-600">Espèce</span>
			</h1>
			<p class="text-slate-600 max-w-2xl mx-auto text-sm sm:text-base">
				Diagramme en barres groupées illustrant la répartition du nombre d'individus recensés par espèce dans la colonie.
			</p>
		</div>

		<!-- Carte du Graphique -->
		<section class="rounded-3xl border-2 border-pink-200 bg-white/95 p-6 sm:p-8 shadow-sm">
			<div class="flex items-center justify-between mb-4 pb-3 border-b border-pink-100">
				<h2 class="text-lg sm:text-xl font-extrabold text-slate-900">
					Graphique 2 : Diagramme en barres
				</h2>
				<span class="text-xs font-semibold text-slate-500 bg-pink-50 px-2.5 py-1 rounded-full border border-pink-200">
					Bar Chart
				</span>
			</div>

			<figure class="plot-figure-container flex justify-center items-center overflow-x-auto">
				<PlotFigure options={secondChartOptions} />
			</figure>
		</section>

		<!-- Navigation entre les 4 graphiques -->
		<div class="text-center space-y-2">
			<span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Voir les autres graphiques :</span>
			<GraphNavigation current={2} />
		</div>
	</div>
</Layout>
