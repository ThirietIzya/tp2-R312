---
import Menu from '../components/menu.astro';
import Footer from '../components/footer.astro';
import GraphicCookies from '../components/GraphicCookies.astro';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Les cookies</title>
  </head>
  <body>
    <main class="species-shell">
      <Menu />

      <div class="species-header">
        <h1 class="species-title">Le coin des gourmands</h1>
        <h2 class="species-subtitle">Analyse nutritionnelle des cookies</h2>
      </div>

      <section class="species-panel">
        <GraphicCookies />
      </section>

      <Footer />
    </main>
  </body>
</html>

<style>
  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: #f3f3f1;
    color: #111;
    font-family: "Segoe UI", Tahoma, sans-serif;
  }

  .species-shell {
    max-width: 1200px;
    margin: 0 auto 3rem;
    padding: 0 1rem;
  }

  .species-header {
    margin: 1.5rem 0 1.25rem;
    text-align: center;
  }

  .species-title {
    margin: 0;
    font-size: clamp(2.8rem, 5vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
    font-weight: 900;
  }

  .species-subtitle {
    margin: 1.2rem 0 0;
    font-size: clamp(1.8rem, 2.7vw, 3rem);
    line-height: 1.15;
    font-weight: 700;
  }

  .species-panel {
    background: #f4dfe7;
    border: 2px solid #ef9bb6;
    border-radius: 30px;
    padding: 1.5rem;
    box-sizing: border-box;
  }

  @media (max-width: 700px) {
    .species-shell {
      padding: 0 0.75rem;
    }

    .species-panel {
      padding: 1rem;
    }
  }
</style>