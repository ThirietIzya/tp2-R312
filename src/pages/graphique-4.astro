---
import PlotFigure from '../components/PlotFigure.astro';
import Menu from '../components/menu.astro';
import Footer from '../components/footer.astro';
import GraphNavigation from '../components/GraphNavigation.astro';
import * as Plot from '@observablehq/plot';
import penguins from '../data/penguins.json';

const penguinsWithMass = penguins.filter((penguin) => penguin.body_mass_g !== null);

const bodyMassBySpeciesOptions = {
  title: 'Masse corporelle par espèce',
  subtitle: 'Comparaison de la médiane et de la dispersion',
  caption: 'Figure 4. Distribution de la masse corporelle par espèce.',
  ariaLabel: 'Diagramme en boîte comparant la masse corporelle des espèces de manchots',
  y: { label: 'Masse corporelle (g)', grid: true },
  color: { legend: false },
  marks: [
    Plot.boxY(penguinsWithMass, {
      x: 'species',
      y: 'body_mass_g',
      fill: 'species',
      inset: 12
    }),
    Plot.dot(
      penguinsWithMass,
      Plot.groupX({ y: 'mean' }, { x: 'species', y: 'body_mass_g', fill: 'white', stroke: 'black', r: 4 })
    )
  ]
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Graphique 4 - Masse par espèce</title>
  </head>
  <body id="top" style="max-width: 900px; margin: 2rem auto; font-family: sans-serif;">
    <Menu />
    <main>
      <h1>Graphique 4 : Masse corporelle par espèce</h1>
      <figure>
        <PlotFigure options={bodyMassBySpeciesOptions} />
      </figure>
      <GraphNavigation current={4} />
    </main>
    <Footer />
  </body>
</html>