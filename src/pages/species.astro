---
import Menu from '../components/menu.astro';
import GraphicSpecies from '../components/GraphicSpecies.astro';
import Footer from '../components/footer.astro';

const speciesList = ['Adelie', 'Chinstrap', 'Gentoo'];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Trie par espèces</title>
  </head>
  <body>
    <main class="species-shell">
      <Menu />

      <div class="species-slider-wrap" id="species-slider-wrap">
        <div class="species-slider" id="species-slider">
          {speciesList.map((name) => (
            <section id={name.toLowerCase()} class="species-slide">
              <div class="species-slide__title-wrap">
                <h1 class="species-title">Les pingouins {name}</h1>
                <h2 class="species-subtitle">Graphique de l'espèce : {name}</h2>
              </div>
              <GraphicSpecies species={name} />
            </section>
          ))}
        </div>
      </div>

      <Footer />
    </main>

  </body>
</html>

<style>
  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: #f3f3f1;
    color: #111;
    font-family: "Segoe UI", Tahoma, sans-serif;
  }

  .species-shell {
    max-width: 1200px;
    margin: 0 auto 3rem;
    padding: 0 1rem;
  }

  .species-title {
    margin: 0;
    font-size: clamp(2.8rem, 5vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
    font-weight: 900;
  }

  .species-subtitle {
    margin: 1.2rem 0 1.4rem;
    font-size: clamp(1.8rem, 2.7vw, 3rem);
    line-height: 1.15;
    font-weight: 700;
  }

  .species-slider-wrap {
    overflow-x: auto;
    overflow-y: hidden;
    position: relative;
    width: 100%;
    padding-bottom: 1rem;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .species-slider-wrap::-webkit-scrollbar {
    display: none;
  }

  .species-slider {
    display: flex;
    width: 300%;
    transition: transform 0.5s ease;
  }

  .species-slide {
    width: 100%;
    min-height: 620px;
    flex: 0 0 33.333%;
    scroll-snap-align: start;
  }

  .species-slide__title-wrap {
    margin-bottom: 1rem;
  }

  @media (max-width: 700px) {
    .species-shell {
      padding: 0 0.75rem;
    }

    .species-anchor-nav {
      justify-content: flex-start;
      border-radius: 20px;
    }

    .species-slide {
      min-height: 540px;
    }
  }
</style>
